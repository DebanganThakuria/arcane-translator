# Arcane Translator configuration.
#
# Copy to .env and fill in the provider you use. Real environment variables
# always take precedence over this file, so it is safe to leave it in place.
#
#   cp .env.example .env
#
# Never commit .env. It is listed in .gitignore.

# ---- Server -----------------------------------------------------------------
# Port the Go API listens on. The frontend derives its API host from this.
ARCANE_PORT=8088

# Where the SQLite database lives. Defaults to ./data/data.db in a checkout, or
# ~/.arcane-translator/data.db for a packaged install.
# ARCANE_DB_PATH=/absolute/path/to/data.db

# ---- Translation provider ---------------------------------------------------
# One of:
#   bedrock  any chat model on AWS Bedrock, through the Converse API
#   claude   Anthropic models on AWS Bedrock, through Anthropic's native API
#   litellm  any model behind a LiteLLM gateway, through its OpenAI-compatible API
ARCANE_LLM_PROVIDER=bedrock

# ---- bedrock / claude (AWS Bedrock) -----------------------------------------
# Credentials come from the standard AWS chain: environment variables, a shared
# profile, or an instance role. Nothing is read from here.
#
# With IAM Identity Center (AWS SSO), set up a profile once with
# `aws configure sso`, then name it here. Run `aws sso login` when the session
# expires and the SDK refreshes role credentials on its own. This is the
# supported path: Identity Center does not issue long-lived access keys.
# AWS_PROFILE=your-sso-profile
AWS_REGION=us-east-1

# The model to call. The bedrock provider accepts any Bedrock chat model id,
# for example:
#   zai.glm-4.7
#   moonshotai.kimi-k2.5
#   deepseek.v3.2
#   amazon.nova-pro-v1:0
# a cross-region inference profile id such as
#   us.anthropic.claude-sonnet-4-6
# or an application inference profile ARN, which embeds your AWS account id:
#   arn:aws:bedrock:<region>:<account-id>:application-inference-profile/<id>
# The claude provider accepts only Anthropic models and profiles.
ARCANE_BEDROCK_MODEL_ID=

# ---- litellm ----------------------------------------------------------------
# A LiteLLM virtual key and the gateway's OpenAI-compatible base URL. Both are
# required for the litellm provider.
# LITELLM_API_KEY=
# ARCANE_LITELLM_BASE_URL=https://litellm.example.com/v1
# Any model name the gateway serves to your key.
# ARCANE_LITELLM_MODEL=claude-sonnet-5-5
