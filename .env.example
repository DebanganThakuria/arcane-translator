# Arcane Translator configuration.
#
# Copy to .env and fill in the provider you use. Real environment variables
# always take precedence over this file, so it is safe to leave it in place.
#
#   cp .env.example .env
#
# Never commit .env. It is listed in .gitignore.

# ---- Server -----------------------------------------------------------------
# Port the Go API listens on. The frontend derives its API host from this.
ARCANE_PORT=8088

# Where the SQLite database lives. Defaults to ./data/data.db in a checkout, or
# ~/.arcane-translator/data.db for a packaged install.
# ARCANE_DB_PATH=/absolute/path/to/data.db

# ---- Translation provider ---------------------------------------------------
# One of: claude (AWS Bedrock), gemini (Google AI), openai.
ARCANE_LLM_PROVIDER=claude

# ---- claude / AWS Bedrock ---------------------------------------------------
# Credentials come from the standard AWS chain: environment variables, a shared
# profile (~/.aws/credentials), or an instance role. Nothing is read from here.
AWS_REGION=us-east-1

# A Bedrock model id, for example:
#   anthropic.claude-sonnet-4-20250514-v1:0
# or an application inference profile ARN, which embeds your AWS account id:
#   arn:aws:bedrock:<region>:<account-id>:application-inference-profile/<id>
ARCANE_BEDROCK_MODEL_ID=

# ---- gemini -----------------------------------------------------------------
# https://ai.google.dev/gemini-api/docs/api-key
# GEMINI_API_KEY=
# ARCANE_GEMINI_MODEL=gemini-2.5-flash

# ---- openai -----------------------------------------------------------------
# OPENAI_API_KEY=
# ARCANE_OPENAI_MODEL=gpt-5
# Set for an OpenAI-compatible endpoint such as a local runner.
# OPENAI_API_BASE_URL=
